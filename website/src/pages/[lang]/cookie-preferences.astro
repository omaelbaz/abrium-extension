---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() { return [ { params: { lang: 'ar' } }, { params: { lang: 'fr' } }, { params: { lang: 'es' } }, { params: { lang: 'pt' } } ]; }
const { lang } = Astro.params;
const translations = {"ar":{"title":"تفضيلات ملفات تعريف الارتباط","html":"<h1>تفضيلات ملفات تعريف الارتباط</h1><p>يمكنك تغيير تفضيلات تتبع Google Analytics 4 هنا.</p><br/><div style='display:flex;gap:var(--space-4)'><button id='pref-reject' class='button button-outline'>رفض الكل</button><button id='pref-accept' class='button'>قبول الكل</button></div><script>document.addEventListener('DOMContentLoaded', () => { document.getElementById('pref-accept').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'accepted'); alert('تم التحديث: قبول'); location.reload(); }); document.getElementById('pref-reject').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'rejected'); alert('تم التحديث: رفض'); location.reload(); }); });</script>"},"fr":{"title":"Préférences de cookies","html":"<h1>Préférences de cookies</h1><p>Modifiez vos préférences Google Analytics 4 ici.</p><br/><div style='display:flex;gap:var(--space-4)'><button id='pref-reject' class='button button-outline'>Tout refuser</button><button id='pref-accept' class='button'>Tout accepter</button></div><script>document.addEventListener('DOMContentLoaded', () => { document.getElementById('pref-accept').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'accepted'); alert('Mise à jour : Accepté'); location.reload(); }); document.getElementById('pref-reject').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'rejected'); alert('Mise à jour : Refusé'); location.reload(); }); });</script>"},"es":{"title":"Preferencias de cookies","html":"<h1>Preferencias de cookies</h1><p>Cambia tus preferencias de Google Analytics 4 aquí.</p><br/><div style='display:flex;gap:var(--space-4)'><button id='pref-reject' class='button button-outline'>Rechazar todo</button><button id='pref-accept' class='button'>Aceptar todo</button></div><script>document.addEventListener('DOMContentLoaded', () => { document.getElementById('pref-accept').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'accepted'); alert('Actualizado: Aceptado'); location.reload(); }); document.getElementById('pref-reject').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'rejected'); alert('Actualizado: Rechazado'); location.reload(); }); });</script>"},"pt":{"title":"Preferências de cookies","html":"<h1>Preferências de cookies</h1><p>Altere suas preferências do Google Analytics 4 aqui.</p><br/><div style='display:flex;gap:var(--space-4)'><button id='pref-reject' class='button button-outline'>Rejeitar tudo</button><button id='pref-accept' class='button'>Aceitar tudo</button></div><script>document.addEventListener('DOMContentLoaded', () => { document.getElementById('pref-accept').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'accepted'); alert('Atualizado: Aceito'); location.reload(); }); document.getElementById('pref-reject').addEventListener('click', () => { localStorage.setItem('cookie_consent', 'rejected'); alert('Atualizado: Rejeitado'); location.reload(); }); });</script>"}};
const t = translations[lang as keyof typeof translations];
---
<Layout title={t.title} description={t.title}>
  
  <div set:html={t.html} />
</Layout>
