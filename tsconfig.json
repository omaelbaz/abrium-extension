{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,

    /* Vite type-checks separately and never emits from tsc. Source imports
       carry explicit .ts extensions so the same files also run under Node's
       native type stripping (tools/build-states-preview.mjs). */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* "Strict TypeScript, no `any`" — CLAUDE.md, Conventions.
       strict alone permits several unsound patterns, so the extras below are
       part of the rule, not decoration. */
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Keeps every construct erasable, so Node can strip types without a
       compile step and the preview generator stays dependency-free. */
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "types": ["chrome", "vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
