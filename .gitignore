# Service account keys and any other local credential. NOTHING under
# credentials/ is ever committed — the Google Indexing API key lives here.
# Keep these rules in plain UTF-8: this file has twice been corrupted by
# PowerShell Add-Content writing UTF-16LE, which silently disables every
# rule written that way (`git check-ignore` showed *.zip matching nothing).
credentials/
*.serviceaccount.json
service-account*.json
gcp-*.json
.env
.env.*
